# --- Creditcoin CC3 Testnet ---
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/
CREDITCOIN_CHAIN_ID=102031

# --- Source chains (where user positions actually live) ---
SOURCE_CHAIN_KEY=1                     # 1 = Ethereum, adjust per @gluwa/usc-sdk chain key mapping
SOURCE_CHAIN_RPC_ETHEREUM_SEPOLIA=
SOURCE_CHAIN_RPC_SOLANA_DEVNET=

# --- Per-proof values (set at runtime by oracle-worker, not statically) ---
# SOURCE_CHAIN_BLOCK_HEIGHT=<block-height>
# SOURCE_CHAIN_TXN_HASH=<transaction-hash>

# --- Deployed contract addresses (fill in after first testnet deploy) ---
ASC_CONTRACT_ADDRESS=
SETTLEMENT_CONTRACT_ADDRESS=

# Same two addresses, VITE_-prefixed. Vite only exposes prefixed vars to
# client code (frontend/src/contracts.ts reads these, not the ones above) -
# keep both pairs in sync when addresses change.
VITE_ASC_CONTRACT_ADDRESS=
VITE_SETTLEMENT_CONTRACT_ADDRESS=

# --- Data sources ---
THE_GRAPH_API_KEY=
COINGECKO_API_KEY=
CHAINLINK_FEED_ADDRESS=

# --- Wallet (testnet only — never commit real keys) ---
DEPLOYER_PRIVATE_KEY=
