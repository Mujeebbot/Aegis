# Aegis environment. Copy to .env at the repo root (both backend services read
# the root .env, then their own folder .env which overrides it).
#
# Nothing here is secret except DEPLOYER_PRIVATE_KEY and the API keys.
# Testnet only - never put a key holding real funds in this file.

# =============================================================================
# Creditcoin CC3 Testnet
# =============================================================================
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031

# =============================================================================
# Source chains (where user positions actually live)
# =============================================================================
# NOTE: chainKey is Creditcoin's internal id for an attested source chain and is
# NOT the chain's own chainId. Verified against the live ChainInfo precompile:
#
#     chainKey 1  ->  chainId 11155111  (Sepolia)
#     chainKey 3  ->  chainId 1         (Ethereum mainnet)
#
# The backend maps between them in ai-monitor/src/chains.js. Do not hardcode a
# chainKey anywhere else; `npm run test:oracle-connection` fails if that table
# drifts from what the precompile reports.
SOURCE_CHAIN_RPC_ETHEREUM_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
SOURCE_CHAIN_RPC_ETHEREUM=

# NOT CURRENTLY USABLE: the CC3 testnet ChainInfo precompile attests only
# chainKey 1 (Sepolia) and chainKey 3 (Ethereum). Solana is not an attested
# source chain, so no proof can be generated for it and the backend does not
# read this var. Left here as a placeholder for if/when Creditcoin adds it.
# SOURCE_CHAIN_RPC_SOLANA_DEVNET=

# Transaction the oracle-worker proves when an alert carries no sourceTxHash.
# Set this to a real source-chain tx for demos and connection tests.
SOURCE_CHAIN_TXN_HASH=
SOURCE_CHAIN_DEFAULT_CHAIN_ID=11155111

# =============================================================================
# Deployed contract addresses (fill in after the first testnet deploy)
# =============================================================================
ASC_CONTRACT_ADDRESS=
SETTLEMENT_CONTRACT_ADDRESS=

# Same two addresses, VITE_-prefixed. Vite only exposes prefixed vars to
# client code (frontend/src/contracts.ts reads these, not the ones above) -
# keep both pairs in sync when addresses change.
VITE_ASC_CONTRACT_ADDRESS=
VITE_SETTLEMENT_CONTRACT_ADDRESS=

# =============================================================================
# Wallet (testnet only)
# =============================================================================
DEPLOYER_PRIVATE_KEY=

# =============================================================================
# ai-monitor  (off-chain risk monitor - HTTP API + 30s poll loop)
# =============================================================================
AI_MONITOR_PORT=4001
AI_MONITOR_HOST=0.0.0.0
# Shared secret for mutating routes (POST /watchlist, POST /poll). Empty = open.
AI_MONITOR_API_KEY=

# live | fixture | auto   (auto = live when THE_GRAPH_API_KEY is set)
# fixture mode serves scripted positions and needs no API keys at all - use it
# for demos, CI, and to make an alert fire on demand.
AI_MONITOR_DATA_MODE=auto

AI_MONITOR_POLL_ENABLED=true
AI_MONITOR_POLL_INTERVAL_MS=30000
AI_MONITOR_POLL_CONCURRENCY=5

# Alert threshold. MUST stay <= the Settlement contract's SAFE_THRESHOLD (1.05):
# the contract rejects protectPosition at or above it, so a higher value here
# would only produce guaranteed-to-revert submissions.
AI_MONITOR_DEFAULT_THRESHOLD=1.05
AI_MONITOR_CRITICAL_THRESHOLD=1.01
# How far ahead the trend model projects when deciding if a position is heading
# into liquidation, even though it is currently healthy.
AI_MONITOR_FORECAST_HORIZON_SEC=900
AI_MONITOR_HISTORY_SIZE=40
AI_MONITOR_ALERT_COOLDOWN_MS=300000

# Positions to monitor at boot: "chainId:address[:protocol]", comma separated.
AI_MONITOR_WATCHLIST=
AI_MONITOR_PROTOCOLS=aave-v3,compound-v3,morpho-blue

# =============================================================================
# Data sources
# =============================================================================
THE_GRAPH_API_KEY=
THE_GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
THE_GRAPH_TIMEOUT_MS=10000
# Subgraph deployment ids: "protocol:chainId=<id>", comma separated.
# A full https:// URL is accepted instead of an id for studio/self-hosted.
THE_GRAPH_SUBGRAPH_IDS=

COINGECKO_API_KEY=
COINGECKO_BASE_URL=
PRICE_CACHE_TTL_MS=30000
PRICE_TIMEOUT_MS=8000

# Chainlink feeds, preferred over CoinGecko because the lending protocols price
# collateral with them - using the same oracle keeps our HF matching theirs.
# Format: "chainId:SYMBOL=0xfeed", comma separated. Wrapped assets resolve to
# their underlying automatically (WETH/stETH/wstETH/cbETH/rETH -> ETH, WBTC ->
# BTC), so one ETH feed covers all the ETH derivatives.
# Sepolia ETH/USD, verified working:
#   CHAINLINK_FEEDS=11155111:ETH=0x694AA1769357215DE4FAC081bf1f309aDC325306
CHAINLINK_FEEDS=
# Single-feed shorthand: treated as ETH/USD on SOURCE_CHAIN_DEFAULT_CHAIN_ID.
# Reading a feed also needs that chain's SOURCE_CHAIN_RPC_* var set above.
CHAINLINK_FEED_ADDRESS=

# =============================================================================
# oracle-worker  (proof generation + on-chain submission)
# =============================================================================
ORACLE_WORKER_PORT=4002
ORACLE_WORKER_HOST=0.0.0.0
# Shared secret on POST /alerts. ai-monitor sends it as a bearer token.
ORACLE_WORKER_API_KEY=

# Where ai-monitor posts risk alerts.
ORACLE_WORKER_WEBHOOK_URL=http://127.0.0.1:4002/alerts
AI_MONITOR_ALERTS_ENABLED=true
AI_MONITOR_ALERT_TIMEOUT_MS=10000
AI_MONITOR_ALERT_RETRIES=3

# Where oracle-worker reads position data back from.
AI_MONITOR_BASE_URL=http://127.0.0.1:4001
AI_MONITOR_TIMEOUT_MS=10000
# Re-check risk immediately before submitting. Proof generation takes minutes;
# if the position recovered meanwhile, this avoids a reverting submission.
ORACLE_RECHECK_BEFORE_SUBMIT=true

# Build and verify proofs but never send a transaction. Safe rehearsal mode.
ORACLE_DRY_RUN=false
# Dry-run the proof against the Block Prover precompile (free eth_call) before
# spending gas on the ASC submission. Strongly recommended.
ORACLE_PREFLIGHT_VERIFY=true

ORACLE_ATTESTATION_POLL_INTERVAL_MS=15000
ORACLE_ATTESTATION_TIMEOUT_MS=900000
ORACLE_ATTESTATION_EXTRA_DELAY_MS=15000
ORACLE_PROOF_BUILDER_TIMEOUT_MS=60000

ORACLE_QUEUE_CONCURRENCY=2
ORACLE_QUEUE_MAX_ATTEMPTS=4
ORACLE_QUEUE_BACKOFF_MS=5000
ORACLE_QUEUE_MAX_BACKOFF_MS=120000
ORACLE_DEDUPE_TTL_MS=3600000

ORACLE_MAX_GAS_LIMIT=3000000
# Refuse to submit below this signer balance, in wei. Default 0.01 tCTC.
ORACLE_MIN_BALANCE_WEI=10000000000000000
ORACLE_CONFIRMATIONS=1

# =============================================================================
# Logging (both services)
# =============================================================================
LOG_LEVEL=info
# 1 = human-readable lines instead of JSON.
LOG_PRETTY=
