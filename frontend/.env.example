# ─── Aegis Frontend Environment Variables ─────────────────────────────────────
# Copy this to .env.local and fill in your values

# WalletConnect Project ID — get from https://cloud.walletconnect.com
VITE_WALLET_CONNECT_PROJECT_ID=

# Ethereum Sepolia RPC (optional — falls back to public node)
VITE_RPC_ETHEREUM_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# Creditcoin CC3 Testnet RPC
VITE_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Settlement Contract on CC3 (once deployed)
VITE_SETTLEMENT_CONTRACT_ADDRESS=

# Attestcoin / ASC Contract on CC3 (once deployed)
VITE_ASC_CONTRACT_ADDRESS=
