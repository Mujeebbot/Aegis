{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "contracts",
    "ai-monitor",
    "oracle-worker"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "compile:contracts": "npm run compile --workspace=contracts",
    "test:contracts": "npm run test --workspace=contracts",
    "start:monitor": "npm start --workspace=aegis-ai-monitor",
    "start:worker": "npm start --workspace=aegis-oracle-worker",
    "test:backend": "npm test --workspace=aegis-ai-monitor && npm test --workspace=aegis-oracle-worker",
    "test:monitor": "npm test --workspace=aegis-ai-monitor",
    "test:worker": "npm test --workspace=aegis-oracle-worker",
    "test:oracle-connection": "npm run test-connection --workspace=aegis-oracle-worker"
  }
}
